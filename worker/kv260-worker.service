[Unit]
Description=KV260 FPGA Worker
Wants=network-online.target
Requires=kv260-pynq-dt.service kv260-pynq-clear-pl-state.service
After=network-online.target kv260-pynq-dt.service kv260-pynq-clear-pl-state.service

[Service]
Type=simple
WorkingDirectory=/opt/kv260-worker
Environment=BOARD=KV260
Environment=XILINX_XRT=/usr
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONNOUSERSITE=1
Environment=KV260_WORKER_ARTIFACT_ROOT=/var/lib/kv260-worker/artifacts
ExecStart=/opt/kv260-pynq/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8080 --workers 1
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
